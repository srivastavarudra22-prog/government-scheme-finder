PORT=5000
NODE_ENV=development

# ── Supabase ──────────────────────────────────────────────────────────────────
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key

# Service role key — only needed for the one-time ingestion script (ingest-rag.js)
# NEVER expose this in frontend code or commit to version control
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ── RAG Configuration ──────────────────────────────────────────────────────────
# Set to 'gemini' after running: node backend/scripts/ingest-rag.js
# Set to 'none' to disable RAG and use the safe stub
RAG_PROVIDER=none
RAG_VECTOR_STORE=pgvector

# ── Google Gemini API ──────────────────────────────────────────────────────────
# Get your free API key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key
GEMINI_EMBEDDING_MODEL=text-embedding-004
GEMINI_CHAT_MODEL=gemini-1.5-flash
